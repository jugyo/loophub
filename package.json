{
  "name": "loophub",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub-style issue/PR hub over local git repositories, built for AI agents to run development loops while a human supervises.",
  "license": "MIT",
  "author": "Kazuyuki Kohno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jugyo/loophub.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "lh": "cli/index.ts",
    "lh-web": "web/server/index.ts",
    "lh-worker": "worker/index.ts",
    "lh-watcher-git": "worker/git-watcher-index.ts",
    "lh-watcher-github": "worker/github-watcher-index.ts",
    "lh-watcher-agents": "worker/agents-watcher-index.ts",
    "lh-dispatcher": "worker/dispatcher-index.ts",
    "lh-job-queue": "worker/job-queue-index.ts"
  },
  "scripts": {
    "postinstall": "npm --prefix web install",
    "lh": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx cli/index.ts",
    "lh-web": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx web/server/index.ts",
    "lh-worker": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx worker/index.ts",
    "lh-watcher-git": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx worker/git-watcher-index.ts",
    "lh-watcher-github": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx worker/github-watcher-index.ts",
    "lh-watcher-agents": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx worker/agents-watcher-index.ts",
    "lh-dispatcher": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx worker/dispatcher-index.ts",
    "lh-job-queue": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx worker/job-queue-index.ts",
    "serve": "concurrently --kill-others --names web,git,github,agents,dispatcher,queue \"npm run lh-web\" \"npm run lh-watcher-git\" \"npm run lh-watcher-github\" \"npm run lh-watcher-agents\" \"npm run lh-dispatcher\" \"npm run lh-job-queue\"",
    "serve:debug": "concurrently --kill-others --names web,git,github,agents,dispatcher,queue \"npm run lh-web -- --debug\" \"npm run lh-watcher-git\" \"npm run lh-watcher-github\" \"npm run lh-watcher-agents\" \"npm run lh-dispatcher\" \"npm run lh-job-queue\"",
    "contract": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx scripts/emit-rpc-contract.ts",
    "migration:new": "node --import tsx scripts/new-migration.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "NODE_OPTIONS='--experimental-sqlite --disable-warning=ExperimentalWarning' vitest run && npm run test:web",
    "test:web": "npm --prefix web test",
    "test:integration": "NODE_OPTIONS='--experimental-sqlite --disable-warning=ExperimentalWarning' vitest run --config vitest.integration.config.ts",
    "test:full": "NODE_OPTIONS='--experimental-sqlite --disable-warning=ExperimentalWarning' vitest run --config vitest.full.config.ts && npm run test:web",
    "test:watch": "NODE_OPTIONS='--experimental-sqlite --disable-warning=ExperimentalWarning' vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
